				qcom,pipe0 {
					label = "hsusb-qdss-in-0";
					qcom,data-fifo-offset = <0x0>;
					qcom,data-fifo-size = <0xe00>;
					qcom,descriptor-fifo-offset = <0xe00>;
					qcom,descriptor-fifo-size = <0x200>;
					qcom,dir = <0x1>;
					qcom,dst-bam-pipe-index = <0x0>;
					qcom,peer-bam = <0x0>;
					qcom,peer-bam-physical-address = <0x6044000>;
					qcom,pipe-num = <0x0>;
					qcom,src-bam-pipe-index = <0x0>;
					qcom,usb-bam-mem-type = <0x2>;
				};
			};
		};

		venus-ddr-gov {
			compatible = "qcom,msm-vidc,governor,table";
			status = "ok";

			qcom,bus-freq-table {

				qcom,profile-dec {
					qcom,codec-mask = <0xffffffff>;
					qcom,load-busfreq-tbl = <0x3bc40 0x93b48 0x34bc0 0x83d60 0x2f760 0x762a0 0x23280 0x57e40 0x1a5e0 0x41eb0 0x17bb0 0x3b150 0xbdd8 0x1d8a8 0x11940 0x2bf20 0x8ca0 0x15f90 0x4650 0xafc8 0x0 0x0>;
				};

				qcom,profile-enc {
					qcom,codec-mask = <0x55555555>;
					qcom,load-busfreq-tbl = <0x3bc40 0xcd528 0x34bc0 0xb4aa0 0x2f760 0xa6040 0x23280 0x79180 0x1a5e0 0x5a550 0x17bb0 0x53020 0xbdd8 0x29810 0x11940 0x3c8c0 0x8ca0 0x1e460 0x4650 0x11170 0x2328 0x88b8 0x0 0x0>;
				};
			};
		};

		vreg_sd_pad {
			compatible = "regulator-gpio";
			enable-active-high;
			enable-gpio = <0x59 0x3f 0x0>;
			gpios = <0x59 0x5b 0x0>;
			linux,phandle = <0xa1>;
			phandle = <0xa1>;
			regulator-max-microvolt = <0x2d0370>;
			regulator-min-microvolt = <0x1b7740>;
			regulator-name = "vreg_sd_pad";
			startup-delay-us = <0x30d40>;
			states = <0x1b7740 0x0 0x2d0370 0x1>;
		};

		wake-gic {
			#interrupt-cells = <0x3>;
			compatible = "qcom,mpm-gic-sdm429", "qcom,mpm-gic";
			interrupt-controller;
			interrupt-parent = <0x5d>;
			interrupts = <0x0 0xab 0x1>;
			linux,phandle = <0x1>;
			phandle = <0x1>;
			qcom,num-mpm-irqs = <0x40>;
			reg = <0x601d0 0x1000 0xb011008 0x4>;
			reg-names = "vmpm", "ipc";
		};

		wake-gpio {
			#interrupt-cells = <0x2>;
			compatible = "qcom,mpm-gpio-sdm429", "qcom,mpm-gpio";
			interrupt-controller;
			interrupt-parent = <0x5d>;
			linux,phandle = <0x46>;
			phandle = <0x46>;
		};

		wcn_etm0 {
			compatible = "qcom,coresight-remote-etm";
			coresight-name = "coresight-wcn-etm0";
			qcom,inst-id = <0x3>;

			port {

				endpoint {
					linux,phandle = <0x152>;
					phandle = <0x152>;
					remote-endpoint = <0x160>;
				};
			};
		};

		wcnss-smp2p {
			compatible = "qcom,smp2p";
			interrupts = <0x0 0x8f 0x1>;
			qcom,ipc = <0xec 0x0 0x12>;
			qcom,local-pid = <0x0>;
			qcom,remote-pid = <0x4>;
			qcom,smem = <0x1c3 0x1af>;

			master-kernel {
				#qcom,smem-state-cells = <0x1>;
				linux,phandle = <0xb1>;
				phandle = <0xb1>;
				qcom,entry-name = "master-kernel";
			};

			slave-kernel {
				#interrupt-cells = <0x2>;
				interrupt-controller;
				linux,phandle = <0xb0>;
				phandle = <0xb0>;
				qcom,entry-name = "slave-kernel";
			};
		};
	};
};
