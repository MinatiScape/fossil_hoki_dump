	aliases {
		i2c1 = "/soc/i2c@78b5000";
		i2c2 = "/soc/i2c@78b6000";
		i2c3 = "/soc/i2c@78b7000";
		i2c4 = "/soc/i2c@78b8000";
		i2c5 = "/soc/i2c@7af5000";
		i2c6 = "/soc/i2c@7af6000";
		i2c7 = "/soc/i2c@7af7000";
		i2c8 = "/soc/i2c@7af8000";
		sdhc1 = "/soc/sdhci@7824900";
		sdhc2 = "/soc/sdhci@7864900";
		spi1 = "/soc/spi@78b5000";
		spi2 = "/soc/spi@78b6000";
		spi3 = "/soc/spi@78b7000";
		spi4 = "/soc/spi@78b8000";
		spi5 = "/soc/spi@7af5000";
		spi6 = "/soc/spi@7af6000";
		spi7 = "/soc/spi@7af7000";
		spi8 = "/soc/spi@7af8000";
	};

	chosen {
		bootargs = "sched_enable_hmp=1 kpti=0";
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x2>;
				};

				core1 {
					cpu = <0x3>;
				};

				core2 {
					cpu = <0x4>;
				};

				core3 {
					cpu = <0x5>;
				};
			};
		};

		cpu@100 {
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,cortex-a53";
			cpu-release-addr = <0x0 0x90000000>;
			device_type = "cpu";
			enable-method = "psci";
			linux,phandle = <0x2>;
			next-level-cache = <0x8>;
			phandle = <0x2>;
			reg = <0x100>;
			sched-energy-costs = <0x6 0x7>;

			l1-dcache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x81>;
				phandle = <0x81>;
				qcom,dump-size = <0x9000>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x7d>;
				phandle = <0x7d>;
				qcom,dump-size = <0x8800>;
			};

			l2-cache {
				cache-level = <0x2>;
				compatible = "arm,arch-cache";
				linux,phandle = <0x8>;
				phandle = <0x8>;
				qcom,dump-size = <0x0>;
			};
		};

		cpu@101 {
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,cortex-a53";
			cpu-release-addr = <0x0 0x90000000>;
			device_type = "cpu";
			enable-method = "psci";
			linux,phandle = <0x3>;
			next-level-cache = <0x8>;
			phandle = <0x3>;
			reg = <0x101>;
			sched-energy-costs = <0x6 0x7>;

			l1-dcache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x82>;
				phandle = <0x82>;
				qcom,dump-size = <0x9000>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x7e>;
				phandle = <0x7e>;
				qcom,dump-size = <0x8800>;
			};
		};

		cpu@102 {
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,cortex-a53";
			cpu-release-addr = <0x0 0x90000000>;
			device_type = "cpu";
			enable-method = "psci";
			linux,phandle = <0x4>;
			next-level-cache = <0x8>;
			phandle = <0x4>;
			reg = <0x102>;
			sched-energy-costs = <0x6 0x7>;

			l1-dcache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x83>;
				phandle = <0x83>;
				qcom,dump-size = <0x9000>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x7f>;
				phandle = <0x7f>;
				qcom,dump-size = <0x8800>;
			};
		};

		cpu@103 {
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,cortex-a53";
			cpu-release-addr = <0x0 0x90000000>;
			device_type = "cpu";
			enable-method = "psci";
			linux,phandle = <0x5>;
			next-level-cache = <0x8>;
			phandle = <0x5>;
			reg = <0x103>;
			sched-energy-costs = <0x6 0x7>;

			l1-dcache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x84>;
				phandle = <0x84>;
				qcom,dump-size = <0x9000>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				linux,phandle = <0x80>;
				phandle = <0x80>;
				qcom,dump-size = <0x8800>;
			};
		};
	};

	energy-costs {
		compatible = "sched-energy";
		linux,phandle = <0x28a>;
		phandle = <0x28a>;

		cluster-cost0 {
			busy-cost-data = <0xea600 0x35 0x13ec00 0x3d 0x16da00 0x47 0x1a1300 0x55>;
			idle-cost-data = <0x4 0x3 0x2 0x1>;
			linux,phandle = <0x7>;
			phandle = <0x7>;
		};

		core-cost0 {
