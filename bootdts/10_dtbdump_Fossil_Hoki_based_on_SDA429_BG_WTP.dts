		qcom,rpm-stats@200000 {
			compatible = "qcom,rpm-stats";
			qcom,sleep-stats-version = <0x2>;
			reg = <0x200000 0x1000 0x290014 0x4 0x29001c 0x4>;
			reg-names = "phys_addr_base", "offset_addr", "heap_phys_addrbase";
		};

		qcom,rpmcc {
			#clock-cells = <0x1>;
			compatible = "qcom,rpmcc-sdm429w";
			linux,phandle = <0x9>;
			phandle = <0x9>;
		};

		qcom,smd {
			compatible = "qcom,smd";

			adsp {
				interrupts = <0x0 0x121 0x1>;
				label = "adsp";
				mbox-names = "adsp_smem";
				qcom,ipc = <0xec 0x0 0x8>;
				qcom,remote-pid = <0x2>;
				qcom,smd-channels = "IPCRTR";
				qcom,smd-edge = <0x1>;

				qcom,adsp_qrtr {
					qcom,low-latency;
					qcom,net-id = <0x1>;
				};

				qcom,apr_tal_rpmsg {
					qcom,smd-channels = "apr_audio_svc";
				};

				qcom,diag {
					qcom,smd-channels = "DIAG";
				};

				qcom,diag_cntl {
					qcom,smd-channels = "DIAG_CNTL";
				};
			};

			modem {
				interrupts = <0x0 0x19 0x1>;
				label = "mpss";
				qcom,ipc = <0xec 0x0 0xc>;
				qcom,remote-pid = <0x1>;
				qcom,smd-channels = "IPCRTR";
				qcom,smd-edge = <0x0>;

				qcom,diag {
					qcom,smd-channels = "DIAG";
				};

				qcom,diag_cmd {
					qcom,smd-channels = "DIAG_CMD";
				};

				qcom,diag_cntl {
					qcom,smd-channels = "DIAG_CNTL";
				};

				qcom,diag_dci {
					qcom,smd-channels = "DIAG_2";
				};

				qcom,modem_qrtr {
					qcom,low-latency;
					qcom,net-id = <0x1>;
				};

				qcom.diag_dci_cmd {
					qcom,smd-channels = "DIAG_2_CMD";
				};
			};

			rpm {
				interrupts = <0x0 0xa8 0x1>;
				label = "rpm";
				qcom,ipc = <0xec 0x0 0x0>;
				qcom,smd-edge = <0xf>;

				rpm_requests@0 {
					compatible = "qcom,rpm-smd";
					linux,phandle = <0x1e1>;
					phandle = <0x1e1>;
					qcom,smd-channels = "rpm_requests";
				};
			};

			wcnss {
				interrupts = <0x0 0x8e 0x1>;
				label = "wcnss";
				qcom,ipc = <0xec 0x0 0x11>;
				qcom,remote-pid = <0x4>;
				qcom,smd-channels = "IPCRTR";
				qcom,smd-edge = <0x6>;

				qcom,diag {
					qcom,smd-channels = "APPS_RIVA_DATA";
				};

				qcom,diag_cntl {
					qcom,smd-channels = "APPS_RIVA_CTRL";
				};

				qcom,wcnss_qrtr {
					qcom,low-latency;
					qcom,net-id = <0x1>;
				};
			};
		};

		qcom,smdpkt {
			compatible = "qcom,smdpkt";

			qcom,smdpkt-apps-fm {
				qcom,smdpkt-ch-name = "APPS_FM";
				qcom,smdpkt-dev-name = "smd1";
				qcom,smdpkt-edge = "wcnss";
			};

			qcom,smdpkt-apps-riva-ant-cmd {
				qcom,smdpkt-ch-name = "APPS_RIVA_ANT_CMD";
				qcom,smdpkt-dev-name = "smd5";
				qcom,smdpkt-edge = "wcnss";
			};

			qcom,smdpkt-apps-riva-ant-data {
				qcom,smdpkt-ch-name = "APPS_RIVA_ANT_DATA";
				qcom,smdpkt-dev-name = "smd6";
				qcom,smdpkt-edge = "wcnss";
