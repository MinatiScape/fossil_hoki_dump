				interrupt-parent = <0x1b>;
				interrupts = <0x4c 0x8>;
				linux,phandle = <0x93>;
				phandle = <0x93>;

				mpps@50 {
					#gpio-cells = <0x2>;
					compatible = "qcom,pm8821-mpp", "qcom,ssbi-mpp";
					gpio-controller;
					interrupts = <0x18 0x0 0x19 0x0 0x1a 0x0 0x1b 0x0>;
					linux,phandle = <0x94>;
					phandle = <0x94>;
