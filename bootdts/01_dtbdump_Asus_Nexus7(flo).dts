	thermal-zones {

		cpu-thermal0 {
			coefficients = <0x4af 0x0>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xc 0x7>;

			trips {

				trip0 {
					hysteresis = <0x7d0>;
					linux,phandle = <0x6c>;
					phandle = <0x6c>;
					temperature = <0x124f8>;
					type = "passive";
				};

				trip1 {
					hysteresis = <0x7d0>;
					linux,phandle = <0x6d>;
					phandle = <0x6d>;
					temperature = <0x1adb0>;
					type = "critical";
