			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				port@0 {
					reg = <0x0>;

					endpoint {
						linux,phandle = <0x5a>;
						phandle = <0x5a>;
						remote-endpoint = <0x5c>;
