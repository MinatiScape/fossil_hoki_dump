		riva-pil@3204000 {
			compatible = "qcom,riva-pil";
			interrupt-names = "wdog", "fatal";
			interrupts-extended = <0x1 0x0 0xc7 0x1 0x51 0x6 0x1>;
			linux,phandle = <0x58>;
			memory-region = <0x52>;
			phandle = <0x58>;
			reg = <0x3200800 0x1000 0x3202000 0x2000 0x3204000 0x100>;
			reg-names = "ccu", "dxe", "pmu";
			status = "disabled";
			vddcx-supply = <0x53>;
