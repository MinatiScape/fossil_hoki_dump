		usb@12500000 {
			#reset-cells = <0x1>;
			ahb-burst-config = <0x0>;
			assigned-clock-rates = <0x3938700>;
			assigned-clocks = <0xc 0x80>;
			clock-names = "core", "iface";
			clocks = <0xc 0x80 0xc 0x7e>;
