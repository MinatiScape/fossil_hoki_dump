					phandle = <0x95>;
					reg = <0x50>;
				};

				pwrkey@1c {
					compatible = "qcom,pm8921-pwrkey";
					debounce = <0x3d09>;
					interrupt-parent = <0x25>;
					interrupts = <0x32 0x1 0x33 0x1>;
					pull-up;
					reg = <0x1c>;
				};

				rtc@11d {
					allow-set-time;
					compatible = "qcom,pm8921-rtc";
					interrupt-parent = <0x25>;
					interrupts = <0x27 0x1>;
					reg = <0x11d>;
				};
			};
		};

		qfprom@700000 {
